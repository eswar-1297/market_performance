# Where the data lives. Copy this file to server/.env and fill in your own.
#
# Local Postgres (the one installed on this machine):
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/marketing
#
# Or a hosted one — Render, Neon, Supabase all give you a URL like this:
# DATABASE_URL=postgres://user:password@host.region.provider.com/dbname

# Keeps people signed in across restarts. Any long random string.
JWT_SECRET=change-me-to-something-random
