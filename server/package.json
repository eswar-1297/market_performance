{
  "name": "mpt-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "dev": "node --env-file-if-exists=.env --watch src/index.js",
    "seed": "node --env-file-if-exists=.env src/seed.js",
    "reseed": "node --env-file-if-exists=.env src/seed.js --force",
    "restructure": "node --env-file-if-exists=.env src/restructure.js",
    "import-sqlite": "node --env-file-if-exists=.env src/import-sqlite.js",
    "deploy": "node src/seed.js && node src/restructure.js && node src/index.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "better-sqlite3": "^11.10.0"
  }
}
